# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend AI Integration for Company Experience PDF Processing (Optional)
# If provided, the document processing engine calls Google Gemini API.
# If omitted, high-fidelity deterministic synthesis engine runs automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional for cloud sync)
# If omitted, local in-memory & browser localStorage persistence runs seamlessly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Master Password for Demo Mode
ADMIN_MASTER_PASSWORD=apti@2026
